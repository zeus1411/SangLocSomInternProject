PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=admin_ecdd
DB_USER=postgres
DB_PASSWORD=123456
NODE_ENV=production

JWT_SECRET=zeus_super_key
JWT_EXPIRES_IN=1h

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

NODE_ENV=production
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL=3600

# MINIO (S3 compatible)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=12345678
MINIO_REGION=ap-southeast-1
MINIO_PUBLIC_BUCKET=images-public
MINIO_PRIVATE_BUCKET=private
# Public URL để FE truy cập tải file (nếu bạn expose 9000 ra host)
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# === Rate limit cho login ===
RATE_LIMIT_LOGIN_WINDOW_MS=900000          # 15 phút
RATE_LIMIT_LOGIN_MAX_REQUESTS=5            # 5 lần / WINDOW
RATE_LIMIT_LOGIN_BLOCK_DURATION_MS=900000 # 30 phút

# === Rate limit cho form submission ===
RATE_LIMIT_FORM_WINDOW_MS=300000           # 5 phút
RATE_LIMIT_FORM_MAX_AUTH=10                # user đã login
RATE_LIMIT_FORM_MAX_ANON=3                 # user anonymous
RATE_LIMIT_FORM_BLOCK_DURATION_MS=600000   # 10 phút

# === Backdoor reset rate limit ===
RATE_LIMIT_RESET_KEY= admin_backdoor_reset_key